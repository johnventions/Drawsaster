# Copy to .env for local overrides. Node loads it automatically (--env-file-if-exists).
APP_ENV=dev
PORT=5050
MIN_PLAYERS=3

# local = files under ./storage (no AWS needed); s3 = AWS S3
IMAGE_STORE=local
# S3_BUCKET=my-drawsaster-bucket
# AWS_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9090   # optional: S3-compatible server (MinIO, LocalStack, s3mock)
# Credentials come from the standard AWS chain (env vars, ~/.aws, instance role).
