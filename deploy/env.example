# /opt/drawsaster/.env on the droplet

# Address the shared Caddy proxy serves this app on.
#   http://<droplet-ip>       plain HTTP on the IP, until you have a domain
#   drawsaster.example.com    once its DNS A record points at the droplet (HTTPS is automatic)
# Each project on the droplet needs its own domain (only one can use the bare IP).
SITE_ADDRESS=http://157.245.239.228

APP_ENV=prod
MIN_PLAYERS=3

# local = drawings in a Docker volume on the droplet. Switch to s3 when ready:
IMAGE_STORE=local
# IMAGE_STORE=s3
# S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
