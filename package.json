{
  "name": "drawsaster",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"npm:server:dev\"",
    "vite": "vite",
    "server:dev": "node --watch --env-file-if-exists=.env server/src/index.ts --port=5050",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"server/**/*.test.ts\"",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "express": "^5.3.0",
    "signature_pad": "^5.1.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "sass": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  }
}
